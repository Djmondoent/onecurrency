import React, { useMemo, useState } from 'react'
import { QRCodeCanvas } from 'qrcode.react'
import { getEmail, saveEmail } from '../lib/storage'
import { generateMnemonic, validateMnemonic } from '../lib/mnemonic'
import { encryptMnemonic } from '../lib/crypto'

export default function Onboarding({ onCreate, onImport }: { onCreate: () => Promise<void>, onImport: (m: string) => Promise<void> }) {
  const [showNew, setShowNew] = useState(false)
  const [mnemonic, setMnemonic] = useState('')
  const [ack, setAck] = useState(false)
  const [importText, setImportText] = useState('')
  const [importErr, setImportErr] = useState<string | null>(null)
  const [email, setEmail] = useState<string>(getEmail() || '')

  const createNew = async () => {
    setShowNew(true)
    const m = await generateMnemonic()
    setMnemonic(m)
  }

  const doUse = async () => {
    if (!ack) return
    if (email) saveEmail(email)
    await onImport(mnemonic)
  }

  const doImport = async () => {
    const m = importText.trim().replace(/\s+/g, ' ').toLowerCase()
    if (!validateMnemonic(m)) {
      setImportErr('Invalid mnemonic. Check words and spacing.')
      return
    }
    setImportErr(null)
    await onImport(m)
  }

  return (
    <div className="container">
      <h1 className="heading">Welcome to One Currency</h1>
      <p className="subtle">A modern, beginner-friendly Bitcoin wallet — testnet-ready.</p>

      {!showNew && (
        <div className="row">
          <button className="btn btn-primary" onClick={createNew}>Create New Wallet</button>
        </div>
      )}

      {showNew && (
        <div className="card mt-16">
          <div className="badge" style={{ fontWeight: 600 }}>Your 12-word seed</div>
          <p className="subtle">Write these down in order. Anyone with these words can spend your funds.</p>
          <div className="mono" style={{ background: '#020617', padding: 12, borderRadius: 8, lineHeight: 1.8 }}>
            {mnemonic}
          </div>
          <label style={{ display: 'block', marginTop: 12 }}>
            Email (optional, stored locally)
            <input className="input" type="email" placeholder="you@example.com" value={email} onChange={(e) => setEmail(e.target.value)} />
          </label>
          <div className="note mt-12">
            <div className="warn">Warning: Emailing your 12 words in plain text is unsafe. Anyone with these words can spend your funds.</div>
            <div className="row" style={{ marginTop: 8 }}>
              <button
                className="btn"
                onClick={() => {
                  if (!email) return alert('Enter your email first')
                  const ok = confirm('This is insecure. Do you still want to open an email draft with your 12 words in the body?')
                  if (!ok) return
                  const to = encodeURIComponent(email)
                  const subject = encodeURIComponent('One Currency Testnet Wallet seed (UNSAFE)')
                  const body = encodeURIComponent(`Your 12 words (UNSAFE):\n${mnemonic}\n\nKeep these secret. Anyone with these can spend your funds.`)
                  // Try Gmail compose in a new tab
                  const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${subject}&body=${body}`
                  window.open(gmailUrl, '_blank')
                }}
              >
                Email 12 Words (Gmail)
              </button>
              <button
                className="btn"
                onClick={() => {
                  if (!email) return alert('Enter your email first')
                  const ok = confirm('This is insecure. Do you still want to open your mail app with your 12 words in the body?')
                  if (!ok) return
                  const to = encodeURIComponent(email)
                  const subject = encodeURIComponent('One Currency Testnet Wallet seed (UNSAFE)')
                  const body = encodeURIComponent(`Your 12 words (UNSAFE):\n${mnemonic}\n\nKeep these secret. Anyone with these can spend your funds.`)
                  window.location.href = `mailto:${to}?subject=${subject}&body=${body}`
                }}
              >
                Email 12 Words (Default)
              </button>
            </div>
            <div className="row" style={{ marginTop: 8 }}>
              <button
                className="btn"
                onClick={async () => {
                  if (!email) return alert('Enter your email first')
                  try {
                    const pw = prompt('Enter a passphrase to encrypt your seed (do not lose this passphrase)')
                    if (!pw) return
                    const json = await encryptMnemonic(mnemonic, pw)
                    const to = encodeURIComponent(email)
                    const subject = encodeURIComponent('One Currency encrypted backup')
                    const body = encodeURIComponent(`Encrypted backup (JSON):\n${json}\n\nKeep this email safe. You will need your passphrase to decrypt.`)
                    const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${subject}&body=${body}`
                    window.open(gmailUrl, '_blank')
                  } catch (e: any) {
                    alert(e?.message || 'Failed to create encrypted backup')
                  }
                }}
              >
                Email Encrypted Backup (Gmail)
              </button>
              <button
                className="btn"
                onClick={async () => {
                  if (!email) return alert('Enter your email first')
                  try {
                    const pw = prompt('Enter a passphrase to encrypt your seed (do not lose this passphrase)')
                    if (!pw) return
                    const json = await encryptMnemonic(mnemonic, pw)
                    const to = encodeURIComponent(email)
                    const subject = encodeURIComponent('One Currency encrypted backup')
                    const body = encodeURIComponent(`Encrypted backup (JSON):\n${json}\n\nKeep this email safe. You will need your passphrase to decrypt.`)
                    window.location.href = `mailto:${to}?subject=${subject}&body=${body}`
                  } catch (e: any) {
                    alert(e?.message || 'Failed to create encrypted backup')
                  }
                }}
              >
                Email Encrypted Backup (Default)
              </button>
            </div>
            <div className="row" style={{ marginTop: 8 }}>
              <button
                className="btn"
                onClick={async () => {
                  if (!email) return alert('Enter your email first')
                  try {
                    const pw = prompt('Enter a passphrase to encrypt your seed (do not lose this passphrase)')
                    if (!pw) return
                    const json = await encryptMnemonic(mnemonic, pw)
                    ;(window as any).__lastOnboardingEnc = json
                    alert('Encrypted JSON ready. A QR will be shown below; you can download it. Email body will include the JSON.')
                  } catch (e: any) {
                    alert(e?.message || 'Failed to create encrypted backup')
                  }
                }}
              >
                Generate Encrypted JSON + QR
              </button>
            </div>
            {!!(window as any).__lastOnboardingEnc && (
              <div className="row" style={{ marginTop: 8, alignItems: 'center' }}>
                <QRCodeCanvas id="onb-backup-qr" value={(window as any).__lastOnboardingEnc} size={180} includeMargin={true} />
                <div className="row">
                  <button className="btn" onClick={() => { try { navigator.clipboard.writeText((window as any).__lastOnboardingEnc) } catch {} }}>Copy JSON</button>
                  <button className="btn" onClick={() => {
                    const canvas = document.getElementById('onb-backup-qr') as HTMLCanvasElement | null
                    if (!canvas) return
                    const url = canvas.toDataURL('image/png')
                    const a = document.createElement('a')
                    a.href = url
                    a.download = 'one-currency-seed-backup-qr.png'
                    a.click()
                  }}>Download QR</button>
                </div>
              </div>
            )}
          </div>
          <label style={{ display: 'block', marginTop: 12 }}>
            <input type="checkbox" checked={ack} onChange={(e) => setAck(e.target.checked)} /> I wrote these down and will keep them safe.
          </label>
          <div className="row" style={{ marginTop: 8 }}>
            <button className="btn btn-primary" onClick={doUse} disabled={!ack}>Use This Seed</button>
          </div>
        </div>
      )}

      <div className="card mt-16">
        <div className="badge" style={{ fontWeight: 600 }}>Import existing seed</div>
        <textarea
          className="textarea"
          rows={3}
          placeholder="enter 12-word mnemonic"
          value={importText}
          onChange={(e) => setImportText(e.target.value)}
        />
        {importErr && <div className="alert" style={{ marginTop: 8 }}>{importErr}</div>}
        <div className="row" style={{ marginTop: 8 }}>
          <button className="btn btn-primary" onClick={doImport}>Import</button>
        </div>
      </div>
    </div>
  )
}
