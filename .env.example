SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
SUPABASE_ANON_KEY=
DATABASE_URL=
# Keep real values outside /var/www, for example /etc/onecurrency/onecurrency.env with 0600 permissions.

# Funding API: server-only values. Never prefix secrets with VITE_.
# Place real values in /etc/onecurrency/funding.env, mode 0600.
FUNDING_ENABLED=false
FUNDING_LIVE_ENABLED=false
FUNDING_PORT=3101
FUNDING_ALLOWED_ORIGINS=https://onecurrency.net,https://www.onecurrency.net
MOONPAY_ENV=sandbox
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
