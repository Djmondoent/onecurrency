{
  "name": "testnet-bitcoin-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "deploy:neocities": "node scripts/deploy-neocities.cjs",
    "pack:extension": "powershell -ExecutionPolicy Bypass -File scripts/pack-extension.ps1",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "build:web": "tsc -b && vite build",
    "prebuild:electron": "npm run icon:win",
    "build:electron": "npm run build:web && electron-builder",
    "icon:win": "node scripts/make-icon.mjs",
    "start:funding": "node server/index.mjs",
    "test:funding": "node tests/funding.test.mjs && node tests/funding-client.test.cjs",
    "build:funding": "node scripts/build-funding.mjs"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.0.2",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.1.3",
    "@scure/bip32": "^1.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.21.1",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.5",
    "buffer": "^6.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.1",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^10.0.7",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jimp": "^0.22.12",
    "neocities": "*",
    "png-to-ico": "^2.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "wait-on": "^9.5.1"
  },
  "description": "Bitcoin Testnet Wallet (Web PWA)",
  "main": "electron/main.cjs",
  "author": "@djmondoent",
  "license": "MIT",
  "build": {
    "appId": "net.onecurrency.wallet",
    "productName": "OneCurrency",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
